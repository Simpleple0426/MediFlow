# MediFlow 环境变量
# docker compose 部署时会自动读取此文件

# ── 硅基流动（当前默认提供方）────────────────────────────────────────────────
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ENABLE_THINKING=false
# 没有 Key 时可启动页面和急症提示；普通问答需要有效 Key 与可用额度。
# OpenAI 兼容 Chat Completions：设置 LLM_PROVIDER=openai，并配置下列变量。
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=low
# 可选旧协议：设置 LLM_PROVIDER=anthropic，并配置下列变量。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=

# ── 应用 ──────────────────────────────────────────────────────────────────────
MEDIFLOW_SCENARIO=healthcare
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=mediflow123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:mediflow123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 本地降级路径（仅 development；production 连接失败时中止启动）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
MEDIFLOW_SEED_DEMO_DOCS=true

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 每次模型请求的超时（秒）；聊天请求另有 50 秒总预算。
MEDIFLOW_INTENT_TIMEOUT_S=8
MEDIFLOW_LLM_TIMEOUT_S=15
MEDIFLOW_COMPOSER_TIMEOUT_S=8
# 兼容旧LLM画像提炼路径的最短更新间隔。医疗画像按用户陈述结构化更新，不额外调用LLM。
PROFILE_UPDATE_MIN_INTERVAL_S=60

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 医疗场景默认关闭外部 MCP。接入经核验的医疗资料服务后再显式启用。
MCP_EXTERNAL_ENABLED=false
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,mediflow,mediflow:*,mediflow-python,mediflow-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
MEDIFLOW_ENV=development
# MEDIFLOW_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_ENABLED=true
INTENT_EMBEDDING_PROVIDER=auto
